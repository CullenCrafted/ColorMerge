# Core server (never commit real credentials)
DATABASE_URL=postgresql://username:password@localhost:5432/colormerge
PORT=5000
NODE_ENV=development

# Web hearts: Stripe test mode first. Apply all migrations in numeric order.
COMMERCE_ENABLED=false
COMMERCE_ORIGIN=https://colormerge.xyz
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HEARTS_5=
STRIPE_PRICE_HEARTS_20=
STRIPE_PRICE_HEARTS_60=

# Native hearts: Apple / Google consumables through RevenueCat
NATIVE_COMMERCE_ENABLED=false
NATIVE_COMMERCE_ORIGINS=capacitor://localhost,http://localhost
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENVIRONMENT=SANDBOX
REVENUECAT_PRODUCT_HEARTS_5=
REVENUECAT_PRODUCT_HEARTS_20=
REVENUECAT_PRODUCT_HEARTS_60=
# VITE values ship in the app. Only public SDK keys belong here.
VITE_COMMERCE_ORIGIN=https://colormerge.xyz
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# AdMob server verification; readiness is a release gate, not parental consent
ADMOB_REWARDS_ENABLED=false
ADMOB_CHILD_AUDIENCE_READY=false
ADMOB_REWARD_SECRET=
ADMOB_REWARDED_AD_UNITS=
VITE_ADMOB_ENABLED=false
VITE_ADMOB_CHILD_AUDIENCE_READY=false
VITE_ADMOB_TESTING=true
VITE_ADMOB_ANDROID_INTERSTITIAL_ID=
VITE_ADMOB_IOS_INTERSTITIAL_ID=
VITE_ADMOB_ANDROID_REWARDED_ID=
VITE_ADMOB_IOS_REWARDED_ID=
# Native AdMob APPLICATION IDs go in generated AndroidManifest / Info.plist;
# application IDs differ from ad-unit IDs. See docs/MOBILE_SETUP.md.

# Disposable PostgreSQL only; optional locally, required by CI SQL tests.
# TEST_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/colormerge_test
